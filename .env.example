# Copy to .env and fill in. Never commit real values.
# Generate secrets with: openssl rand -hex 32

# WordPress
WP_HOME=https://health.oldev.site
WP_ADMIN_USER=change-me
WP_ADMIN_PASSWORD=change-me
WP_ADMIN_EMAIL=you@example.com
DB_PASSWORD=change-me

# Signing. SHR_HMAC_SECRET must match the n8n "crypto" credential.
SHR_HMAC_SECRET=change-me
SHR_APP_SECRET=change-me

# n8n and the scanner
SHR_N8N_WEBHOOK_URL=https://n8n.oldev.site/webhook/shr-scan
# Leave empty to use WP_HOME for callbacks.
SHR_CALLBACK_BASE=
# Where n8n reaches the scanner. Sent inside the signed job.
SHR_SCANNER_URL=https://health.oldev.site/scanner
# base64: followed by 32 random bytes. php artisan key:generate --show
SCANNER_APP_KEY=base64:change-me
# Must match the n8n "Health Report Scanner Key" credential.
SCANNER_API_KEY=change-me

# Cloudflare Turnstile. These are Cloudflare's published test keys. Replace them in production.
SHR_TURNSTILE_SITE_KEY=1x00000000000000000000AA
SHR_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Proxies in front of WordPress that append to X-Forwarded-For. Coolify's Traefik is 1.
SHR_TRUSTED_PROXY_HOPS=1

# Limits
SHR_LIMIT_IP_HOUR=5
SHR_LIMIT_IP_DAY=20
SHR_DOMAIN_COOLDOWN_MINUTES=360
SHR_DAILY_SCAN_CAP=100
# Clamped to 50 in code. Brevo's allowance is shared with the main site.
SHR_DAILY_EMAIL_CAP=50
SHR_LIMIT_EMAIL_ADDRESS_DAY=3
SHR_DAILY_AI_CAP=25

# Optional AI summary. Leave either empty to use rule-based text.
SHR_AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# Email. Leave empty to write messages to /tmp/shr-mail inside the container instead of sending.
BREVO_API_KEY=

# Local n8n only (docker-compose.local.yml)
N8N_LOCAL_ENCRYPTION_KEY=change-me
