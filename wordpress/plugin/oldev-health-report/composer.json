{
    "name": "oldev/health-report",
    "description": "Website Health Report WordPress plugin",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.3",
        "dompdf/dompdf": "3.1.6",
        "woocommerce/action-scheduler": "^3.9 || ^4.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "phpcompatibility/phpcompatibility-wp": "2.1.8",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "2.3.4",
        "phpunit/phpunit": "^9.6",
        "szepeviktor/phpstan-wordpress": "2.0.4",
        "wp-coding-standards/wpcs": "3.4.1",
        "wp-phpunit/wp-phpunit": "7.1.3",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Oldev\\HealthReport\\": "src/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
