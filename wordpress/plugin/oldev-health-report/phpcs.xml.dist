<?xml version="1.0"?>
<ruleset name="Website Health Report">
	<description>WordPress Coding Standards for the plugin.</description>

	<file>oldev-health-report.php</file>
	<file>src</file>
	<file>blocks</file>
	<file>tests</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<config name="minimum_wp_version" value="7.1"/>
	<config name="testVersion" value="8.3-"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="oldev-health-report"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="oldev_hr"/>
				<element value="Oldev\HealthReport"/>
			</property>
		</properties>
		<exclude-pattern>tests/*</exclude-pattern>
		<!-- WordPress includes render.php inside a method, so these variables are local, not global. -->
		<exclude-pattern>blocks/*/render.php</exclude-pattern>
	</rule>

	<!-- Custom tables have no WordPress API and no cache layer by design: counters must read the database. -->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<severity>0</severity>
	</rule>
	<!-- The category key "wordpress" is data, and this sniff's autofix would rewrite it. -->
	<rule ref="WordPress.WP.CapitalPDangit">
		<severity>0</severity>
	</rule>
	<!-- PSR-4 class files, required by Composer autoloading. -->
	<rule ref="WordPress.Files.FileName">
		<severity>0</severity>
	</rule>
	<!-- Test doubles and test classes do not need prose docblocks. -->
	<rule ref="Squiz.Commenting">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<!-- Tests read fixtures, seed tables and set request globals on purpose. -->
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.DB.PreparedSQL">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Universal.Operators.DisallowShortTernary">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Universal.Files.SeparateFunctionsFromOO">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Files.OneObjectStructurePerFile">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Arrays.ArrayDeclarationSpacing">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
</ruleset>
