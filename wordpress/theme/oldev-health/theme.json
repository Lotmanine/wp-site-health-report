{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": { "contentSize": "760px", "wideSize": "1080px" },
		"color": {
			"palette": [
				{ "slug": "ink", "name": "Ink", "color": "#0f172a" },
				{ "slug": "muted", "name": "Muted", "color": "#475569" },
				{ "slug": "line", "name": "Line", "color": "#e2e8f0" },
				{ "slug": "surface", "name": "Surface", "color": "#f1f5f9" },
				{ "slug": "paper", "name": "Paper", "color": "#ffffff" },
				{ "slug": "brand", "name": "Brand", "color": "#047857" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "system",
					"name": "System",
					"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.9rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem" },
				{ "slug": "large", "name": "Large", "size": "1.35rem" },
				{ "slug": "hero", "name": "Hero", "size": "clamp(2rem, 6vw, 3.25rem)" }
			]
		},
		"spacing": { "units": [ "px", "rem", "%" ] }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": { "padding": { "left": "20px", "right": "20px" } },
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--brand)" }
			},
			"heading": {
				"typography": { "fontWeight": "700", "lineHeight": "1.2" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--hero)" } },
			"h2": { "typography": { "fontSize": "1.6rem" } },
			"h3": { "typography": { "fontSize": "1.2rem" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
