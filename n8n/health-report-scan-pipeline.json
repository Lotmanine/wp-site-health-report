    {
      "id": "7e394f3a-c8f7-4221-9449-cb76560228be",
      "name": "Summarize DNS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        520
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const queries = $(\"Build DNS Queries\").all();\nconst answers = $input.all();\nconst dns = {\n  spf: { found: false, record: null, error: null },\n  dmarc: { found: false, record: null, error: null },\n  dkim: { found: false, selectors: [], checked: 0, error: null },\n};\nconst texts = (a) => (a.Answer || []).filter((r) => r.type === 16).map((r) => String(r.data).replace(/\"\\s*\"/g, '').replace(/^\"|\"$/g, ''));\nlet dkimErrors = 0;\nanswers.forEach((item, i) => {\n  const q = queries[i].json;\n  const a = item.json;\n  const failed = a.error !== undefined || a.Status === undefined || a.Status === 2;\n  if (q.kind === 'dkim') {\n    dns.dkim.checked++;\n    if (failed) { dkimErrors++; return; }\n    if (texts(a).some((t) => /v=DKIM1|(^|;\\s*)p=/i.test(t))) dns.dkim.selectors.push(q.selector);\n    return;\n  }\n  if (failed) { dns[q.kind].error = 'lookup_failed'; return; }\n  const prefix = q.kind === 'spf' ? /^v=spf1/i : /^v=DMARC1/i;\n  const record = texts(a).find((t) => prefix.test(t));\n  if (record) { dns[q.kind].found = true; dns[q.kind].record = record.slice(0, 380); }\n});\ndns.dkim.found = dns.dkim.selectors.length > 0;\nif (dkimErrors === dns.dkim.checked) dns.dkim.error = 'lookup_failed';\nreturn [{ json: { source: 'dns', dns } }];"
      }
    },
    {
      "id": "bf45dc27-e468-4c7a-b1fd-2ea7618ab4b5",
      "name": "Assemble Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const job = $(\"Verify Job\").first().json;\nlet scanner = null, error = 'scanner_failed', pagespeed = { error: 'pagespeed_unavailable' }, dns = {};\nfor (const item of $input.all()) {\n  const j = item.json;\n  if (j.source === 'scanner') { scanner = j.result || null; error = j.error || error; }\n  if (j.source === 'pagespeed') pagespeed = j.pagespeed;\n  if (j.source === 'dns') dns = j.dns;\n}\nlet nonce = '';\nwhile (nonce.length < 32) nonce += Math.floor(Math.random() * 16).toString(16);\nconst payload = {\n  v: 1, type: 'scan.result', scan_id: job.scan_id,\n  status: scanner ? 'complete' : 'failed', error: scanner ? null : error,\n  issued_at: Math.floor(Date.now() / 1000), nonce, scanner, pagespeed, dns,\n};\nreturn [{ json: { payload_json: JSON.stringify(payload), callback_url: job.callback_url } }];"
      }
    },
