    {
      "id": "72aa7ef2-6ccb-47f6-8bc2-550a280df548",
      "name": "Verify Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const item = $input.first();\nconst req = item.json;\nconst headers = req.headers || {};\nconst deny = (reason) => [{ json: { valid: false, reason } }];\nconst received = String(headers['x-shr-signature'] || '').replace(/^sha256=/, '').trim().toLowerCase();\nconst expected = String(req.expected_signature || '').toLowerCase();\n// Constant-time comparison. The crypto module is not available in Code nodes on this instance.\nlet diff = received.length ^ expected.length;\nfor (let i = 0; i < expected.length; i++) {\n  diff |= (received.charCodeAt(i) || 0) ^ expected.charCodeAt(i);\n}\nif (!expected || diff !== 0) return deny('bad_signature');\nlet job = req.body;\nif (typeof job === 'string') {\n  try { job = JSON.parse(job); } catch (e) { return deny('bad_json'); }\n}\nif (!job || !job.scan_id) {\n  try { job = JSON.parse(Buffer.from(item.binary.data.data, 'base64').toString('utf8')); } catch (e) { return deny('bad_json'); }\n}\nif (job.type !== 'scan.job' || job.v !== 1) return deny('bad_message');\nconst now = Math.floor(Date.now() / 1000);\nif (Math.abs(now - Number(job.issued_at)) > 300) return deny('stale');\nconst store = $getWorkflowStaticData('global');\nstore.nonces = store.nonces || {};\nfor (const key of Object.keys(store.nonces)) {\n  if (store.nonces[key] < now) delete store.nonces[key];\n}\nif (!/^[0-9a-f]{32}$/.test(String(job.nonce)) || store.nonces[job.nonce]) return deny('replayed');\nstore.nonces[job.nonce] = now + 600;\nreturn [{ json: { valid: true, scan_id: job.scan_id, url: job.url, domain: job.domain, callback_url: job.callback_url, scanner_url: job.scanner_url } }];"
      }
    },
