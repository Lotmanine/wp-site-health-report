    {
      "id": "b77536d1-a8e3-4a3c-94ca-29e7ffa81d9c",
      "name": "PageSpeed Insights",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "https://www.googleapis.com/pagespeedonline/v5/runPagespeed",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "={{ $(\"Verify Job\").first().json.url }}"
            },
            {
              "name": "strategy",
              "value": "mobile"
            },
            {
              "name": "category",
              "value": "performance"
            }
          ]
        },
        "options": {
          "timeout": 90000
        }
      },
      "credentials": {},
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "1f3806db-50d0-485c-8871-b42423457c8f",
      "name": "Extract PageSpeed Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const r = $input.first().json;\nconst audits = (r.lighthouseResult && r.lighthouseResult.audits) || null;\nconst category = r.lighthouseResult && r.lighthouseResult.categories && r.lighthouseResult.categories.performance;\nif (!audits || !category) {\n  const message = (r.error && (r.error.message || r.error)) || 'pagespeed_unavailable';\n  return [{ json: { source: 'pagespeed', pagespeed: { error: String(message).slice(0, 180) } } }];\n}\nconst num = (key) => Number((audits[key] && audits[key].numericValue) || 0);\nreturn [{ json: { source: 'pagespeed', pagespeed: { score: Math.round(category.score * 100), lcp_ms: Math.round(num('largest-contentful-paint')), cls: Math.round(num('cumulative-layout-shift') * 1000) / 1000, tbt_ms: Math.round(num('total-blocking-time')), error: null } } }];"
      }
    },
    {
      "id": "0b312c0b-cf01-43c2-9ee4-dba60da9d71c",
      "name": "Build DNS Queries",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        520
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const domain = $(\"Verify Job\").first().json.domain;\nconst selectors = ['default', 'google', 'selector1', 'selector2', 'k1', 'k2', 's1', 's2', 'mail', 'dkim', 'zmail', 'zmail1', 'brevo1', 'brevo2', 'mandrill', 'mxvault', 'smtp', 'protonmail'];\nconst out = [{ json: { kind: 'spf', name: domain } }, { json: { kind: 'dmarc', name: '_dmarc.' + domain } }];\nfor (const s of selectors) out.push({ json: { kind: 'dkim', selector: s, name: s + '._domainkey.' + domain } });\nreturn out;"
      }
    },
    {
      "id": "cd2fee4a-b1e6-481f-bee9-f8b4a81c870f",
      "name": "DNS over HTTPS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1320,
        520
