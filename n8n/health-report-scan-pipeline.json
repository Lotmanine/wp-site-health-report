        "jsCode": "const e = $input.first().json;\nconst code = String((e.error && e.error.message) || e.message || '');\nreturn [{ json: { done: true, source: 'scanner', error: /422/.test(code) ? 'blocked_target' : 'scanner_unavailable' } }];"
      }
