      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const r = $input.first().json;\nconst job = $(\"Verify Job\").first().json;\nif (r.status === 'complete') return [{ json: { done: true, source: 'scanner', result: r.result } }];\nif (r.status === 'failed') return [{ json: { done: true, source: 'scanner', error: r.error || 'scanner_failed' } }];\nif ($runIndex >= 24) return [{ json: { done: true, source: 'scanner', error: 'scanner_timeout' } }];\nreturn [{ json: { done: false, id: r.id, scanner_url: job.scanner_url } }];"
      }
